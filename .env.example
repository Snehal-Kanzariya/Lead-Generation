# Copy to .env and fill in. Never commit .env.

# --- AI (pick one; Gemini has a free tier: https://aistudio.google.com/apikey) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite   # fast default; falls back to gemini-3.5-flash, gemini-3.8-flash
ANTHROPIC_API_KEY=                   # optional alternative (needs paid API credit)
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Discovery ---
# places = Google Places API (New), most reliable; osm = free OpenStreetMap, best-effort; none = off
GOOGLE_PLACES_API_KEY=
DISCOVERY_SOURCE=

# --- Server ---
JWT_SECRET=change-me-to-a-long-random-string
PORT=8787
